NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=52428800
LOG_LEVEL=info

# Signed downloads. Empty means downloads are open (fine locally).
# Set this in production and every /files/... request needs a signature.
DOWNLOAD_SECRET=
DOWNLOAD_TTL_SECONDS=900

# File lifecycle
FILE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
